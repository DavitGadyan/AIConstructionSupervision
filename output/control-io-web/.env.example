DATABASE_URL="file:./dev.db"
# Signs session tokens: anyone who knows it can sign in as any user. Generate one per environment:
#   openssl rand -base64 48
# Production (NODE_ENV=production) refuses to start when it is empty, shorter than 32 bytes or a
# published example value; development falls back to a fixed dev-only key with a warning.
AUTH_SECRET=""
STORAGE_DIR="./storage"
# ANTHROPIC_API_KEY=
# NODEODM_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# OPENAI_API_KEY=
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# On-demand inspections (v1.1) - dispatch simulator that advances orders
# requested -> confirmed -> dispatched -> on_site -> flying -> processing -> delivered.
# "on" runs the 2 s ticker in this process: it invents crews, flights and PDF reports from earlier
# imagery (demo only). "off" disables it (real ops drive orders). Unset: on in development, OFF in
# production (NODE_ENV=production); a production demo install must set "on" and gets a startup warning.
# DISPATCH_SIMULATOR=on
# 1 = real time. Demos pass a larger value on the command line, e.g.
# DISPATCH_TIME_SCALE=240 npx next dev  (1 h ~= 15 s, a full order in ~5 min).
# Frozen per order at creation (Order.timeScale).
DISPATCH_TIME_SCALE=1
# Simulated report processing time after the flight, in hours (the promise is <= 12 h).
DISPATCH_PROCESSING_HOURS=6

# Extra browser origins allowed to call /api with credentials (comma-separated), e.g. the hosted Expo web build.
# Localhost ports are allowed automatically outside production. Native apps need nothing here.
# CORS_ORIGINS=https://app.control.io
